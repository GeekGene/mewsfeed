{
  "happ": {
    "id": "mewsfeed",
    "name": "MewsFeed"
  },
  "auth_methods": ["email_code"],
  "email": {
    "provider": "sendgrid",
    "api_key": "SG.your-sendgrid-api-key-here",
    "from": "noreply@yourdomain.com"
  },
  "hc_auth": {
    "url": "http://localhost:4000",
    "api_token": "your-hc-auth-token-here"
  },
  "session": {
    "store": "memory"
  },
  "network": {
    "bootstrap_url": "http://127.0.0.1:BOOTSTRAP_PORT",
    "relay_url": "http://127.0.0.1:RELAY_PORT"
  },
  "linker_auth": {
    "capabilities": ["dht_read", "dht_write", "k2"]
  },
  "port": 3000,
  "linker_registrations": [
    {
      "linker_url": { "url": "http://localhost:8000" },
      "admin": { "url": "http://localhost:8000", "secret": "local-dev-secret" }
    }
  ]
}
